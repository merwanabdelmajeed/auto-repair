{
  "name": "autorepair-customer-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --port 8081",
    "android": "npm run android:prod",
    "android:dev": "node -e \"require('fs').copyFileSync('.env.dev.bak','.env')\" && cross-env APP_VARIANT=dev expo run:android --port 8081 --variant devDebug",
    "android:prod": "node -e \"require('fs').copyFileSync('.env.prod.bak','.env')\" && cross-env APP_VARIANT=prod expo run:android --port 8081 --variant prodDebug",
    "ios": "npm run ios:prod",
    "ios:dev": "node -e \"require('fs').copyFileSync('.env.dev.bak','.env')\" && cross-env APP_VARIANT=dev expo run:ios --port 8081",
    "ios:prod": "node -e \"require('fs').copyFileSync('.env.prod.bak','.env')\" && cross-env APP_VARIANT=prod expo run:ios --port 8081",
    "web": "expo start --web --port 8081",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/drawer": "^6.7.2",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^7.17.6",
    "@react-navigation/stack": "^7.10.6",
    "amazon-cognito-identity-js": "^6.3.18",
    "emulator": "^0.1.0",
    "expo": "^53.0.0",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-device": "~7.1.4",
    "expo-font": "~13.3.2",
    "expo-notifications": "~0.31.5",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.14",
    "typescript": "~5.8.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testTimeout": 15000,
    "workerIdleMemoryLimit": "512MB",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 70,
        "branches": 70,
        "functions": 70,
        "lines": 70
      }
    }
  }
}
