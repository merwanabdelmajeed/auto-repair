{
  "name": "autorepair-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && esbuild src/functions/**/*.ts --bundle --platform=node --target=node20 --outdir=dist --external:@aws-sdk/* --external:aws-lambda",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-pinpoint-sms-voice-v2": "^3.1090.0",
    "@aws-sdk/client-ses": "^3.600.0",
    "@aws-sdk/client-ssm": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.21.5",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.4.5"
  }
}
